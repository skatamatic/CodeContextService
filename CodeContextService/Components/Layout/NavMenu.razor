@using Microsoft.AspNetCore.Components.Authorization
@inject CodeContextService.Services.AuthService AuthService
@inject NavigationManager Nav
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">CodeContextService</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="analyze">
                Analyze Code
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="github">
                Github
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="pr-analyze">
                Analyze PR
            </NavLink>
        </div>
    </nav>
    <div class="mt-auto px-3 pb-3">
        <AuthorizeView>
            <Authorized>
                <span class="text-light small d-block">@context.User.Identity?.Name</span>
                <button class="btn btn-outline-light btn-sm w-100" @onclick="Logout">Log out</button>
            </Authorized>
        </AuthorizeView>
    </div>
</div>

@code {
    private async Task Logout()
    {
        try { await JS.InvokeVoidAsync("clearAuthToken"); } catch (JSException) { /* auth cookie script may be unavailable */ }
        AuthService.Logout();
        Nav.NavigateTo("login", forceLoad: true);
    }
}