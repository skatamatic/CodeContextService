@page "/analyze"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using Microsoft.JSInterop
@using RoslynTools.Analyzer
@using CodeContextService.Components.Views
@using CodeContextService.Components.ViewModels
@using CodeContextService.Model
@using CodeContextService.Services
@inject IJSRuntime JS
@inject AuthService AuthService
@inject NavigationManager Nav
@implements IAsyncDisposable
@rendermode InteractiveServer

<PageTitle>Code Analyzer</PageTitle>

<HeadContent>
    <!-- helper to scroll a container -->
    <script>
        window.scrollToBottom = id => {
            const el = document.getElementById(id);
            if (el) el.scrollTop = el.scrollHeight;
        };

        // read a cookie by name
        window.getCookieByName = name => {
            const match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
            return match ? decodeURIComponent(match[2]) : null;
        };

        // write a cookie (1 year)
        window.setCookie = (name, value) => {
            document.cookie = `${name}=${encodeURIComponent(value)}; path=/; max-age=${60*60*24*365}`;
        };
    </script>

    <link href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css"
          rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-csharp.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script>
        const analyzerExcludeSegment = (seg) => seg === 'obj' || seg === 'bin' || seg.startsWith('.');
        const analyzerShouldExcludePath = (path) => path.split('/').some(analyzerExcludeSegment);
        window.analyzerGetFolderCsPaths = (inputId) => {
            const input = document.getElementById(inputId);
            if (!input || !input.files || input.files.length === 0) return [];
            const paths = [];
            for (let i = 0; i < input.files.length; i++) {
                const f = input.files[i];
                const path = (f.webkitRelativePath || f.name).replace(/\\/g, '/');
                if (path.toLowerCase().endsWith('.cs') && !analyzerShouldExcludePath(path)) paths.push(path);
            }
            return paths.sort();
        };
        window.analyzerGetFolderSlnPaths = (inputId) => {
            const input = document.getElementById(inputId);
            if (!input || !input.files || input.files.length === 0) return [];
            const paths = [];
            for (let i = 0; i < input.files.length; i++) {
                const f = input.files[i];
                const path = (f.webkitRelativePath || f.name).replace(/\\/g, '/');
                if (path.toLowerCase().endsWith('.sln') && !analyzerShouldExcludePath(path)) paths.push(path);
            }
            return paths.sort();
        };
        window.analyzerZipAndUpload = async (inputId, targetFile, solutionFile, depth, bearerToken, baseUrl, dotNetRef) => {
            const input = document.getElementById(inputId);
            if (!input || !input.files || input.files.length === 0) throw new Error('No folder selected');
            const zip = new JSZip();
            for (let i = 0; i < input.files.length; i++) {
                const f = input.files[i];
                const path = (f.webkitRelativePath || f.name).replace(/\\/g, '/');
                if (!path || path.startsWith('/') || analyzerShouldExcludePath(path)) continue;
                const buf = await f.arrayBuffer();
                zip.file(path, buf);
            }
            const blob = await zip.generateAsync({ type: 'blob' });
            const form = new FormData();
            form.append('zip', blob, 'folder.zip');
            form.append('targetFile', targetFile);
            form.append('solutionFile', solutionFile);
            form.append('depth', String(depth));
            const res = await fetch(new URL('api/analyze-upload', baseUrl).toString(), {
                method: 'POST',
                headers: bearerToken ? { 'Authorization': 'Bearer ' + bearerToken } : {},
                body: form
            });
            const text = await res.text();
            console.log('[analyzerZipAndUpload] Response status=', res.status, 'length=', text.length);
            if (!res.ok) {
                console.error('[analyzerZipAndUpload] Error response:', text.substring(0, 500));
                throw new Error(res.status === 401 ? 'Please log in to use folder upload.' : (text || res.statusText));
            }
            let json;
            try {
                json = JSON.parse(text);
            } catch (parseErr) {
                console.error('[analyzerZipAndUpload] JSON parse failed:', parseErr);
                console.error('[analyzerZipAndUpload] Response preview:', text.substring(0, 300));
                throw new Error('Invalid JSON from server: ' + parseErr.message);
            }
            const keys = Object.keys(json || {});
            console.log('[analyzerZipAndUpload] JSON keys=', keys, 'logs count=', json?.logs?.length, 'results count=', json?.results?.length);
            const payload = JSON.stringify(json);
            console.log('[analyzerZipAndUpload] Payload length for interop=', payload.length);
            try {
                await dotNetRef.invokeMethodAsync('OnUploadComplete', payload);
                console.log('[analyzerZipAndUpload] OnUploadComplete returned successfully');
            } catch (interopErr) {
                console.error('[analyzerZipAndUpload] OnUploadComplete failed:', interopErr);
                throw interopErr;
            }
        };
    </script>
</HeadContent>

<div class="container py-4">
    <h3>Code Analysis</h3>

    <p class="text-muted small mb-3">Choose one mode: analyze a <strong>local file path</strong> on the server, or <strong>upload a zip</strong> of a folder. They cannot be used together.</p>

    <!-- Mode toggle -->
    <div class="mb-3">
        <div class="btn-group" role="group">
            <input type="radio" class="btn-check" name="analyzerMode" id="modeLocal" checked="@(!UseZipMode)" @onchange='() => SetMode(false)' />
            <label class="btn btn-outline-primary" for="modeLocal">Local file path</label>
            <input type="radio" class="btn-check" name="analyzerMode" id="modeZip" checked="@UseZipMode" @onchange='() => SetMode(true)' />
            <label class="btn btn-outline-primary" for="modeZip">Upload folder (zip)</label>
        </div>
    </div>

    <!-- Option 1: Local file path (disabled when zip mode) -->
    <div class="card mb-3 @(UseZipMode ? "opacity-50" : "")">
        <div class="card-header py-2">Local file path</div>
        <div class="card-body">
            <div class="mb-2">
                <label class="form-label small text-muted">Path to .cs file</label>
                <input
                    value="@FilePath"
                    @oninput="@(e => OnFieldChanged("FilePath", e.Value?.ToString()))"
                    class="form-control"
                    placeholder="Full path to a .cs file"
                    disabled="@(IsRunning || UseZipMode)" />
            </div>
            <div class="mb-2">
                <label class="form-label small text-muted">Depth</label>
                <input
                    type="number"
                    value="@Depth"
                    oninput="OnDepthChanged"
                    class="form-control"
                    placeholder="Depth (e.g. 1,2…)"
                    min="0"
                    style="max-width:6em"
                    disabled="@(IsRunning || UseZipMode)" />
            </div>
            <button class="btn btn-primary btn-sm"
                    @onclick="RunAnalysis"
                    disabled="@(IsRunning || UseZipMode)">
                Find Definitions
            </button>
        </div>
    </div>

    <!-- Option 2: Upload folder (disabled when local mode) -->
    <div class="card mb-4 @(!UseZipMode ? "opacity-50" : "")">
        <div class="card-header py-2">Upload folder (zip)</div>
        <div class="card-body">
            <input type="file" id="folderInput" webkitdirectory multiple style="display:none" @onchange="OnFolderSelected" />
            <div class="mb-2">
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick='() => JS.InvokeVoidAsync("eval", "document.getElementById(\"folderInput\").click()")' disabled="@(IsRunning || !UseZipMode)">Select folder</button>
                @if (FolderCsPaths.Any())
                {
                    <span class="ms-2 text-muted small">@FolderCsPaths.Count .cs file(s)</span>
                }
            </div>
            @if (FolderSlnPaths.Count == 0 && FolderCsPaths.Any())
            {
                <div class="alert alert-danger py-2 mb-2">
                    No .sln file in this folder. Choose a folder that contains a solution (.sln) file.
                </div>
            }
            @if (FolderCsPaths.Any())
            {
                <div class="mb-2">
                    <label class="form-label small fw-bold">Solution file (.sln) — required</label>
                    <select class="form-select form-select-sm" @bind="UploadSolutionFile" disabled="@(IsRunning || !UseZipMode)" style="max-width:100%">
                        <option value="">— Select .sln —</option>
                        @foreach (var p in FolderSlnPaths)
                        {
                            <option value="@p">@p</option>
                        }
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label small">Target .cs file to analyze</label>
                    <select class="form-select form-select-sm" @bind="UploadTargetFile" disabled="@(IsRunning || !UseZipMode)" style="max-width:100%">
                        @foreach (var p in FolderCsPaths)
                        {
                            <option value="@p">@p</option>
                        }
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label small">Depth</label>
                    <input type="number" class="form-control form-control-sm" style="max-width:6em" @bind="UploadDepth" min="0" disabled="@(IsRunning || !UseZipMode)" />
                </div>
                <button type="button" class="btn btn-primary btn-sm" @onclick="RunUploadAnalysis"
                        disabled="@(IsRunning || !UseZipMode || string.IsNullOrEmpty(UploadSolutionFile))">
                    Zip and analyze
                </button>
            }
        </div>
    </div>

    <!-- Logs toggle (shared) -->
    <button class="btn btn-secondary btn-sm"
            @onclick="ToggleLogs"
            disabled="@(!Logs.Any())">
        @(LogsExpanded ? "Hide Logs ▲" : "Show Logs ▼") (@Logs.Count)
    </button>

    <!-- Logs -->
    <div class="mt-3">
        <h5 class="h6 text-muted mb-1">Logs</h5>
        <div id="logsContainer"
             class="border rounded p-2 bg-dark text-light font-monospace small"
             style="max-height:@(LogsExpanded ? "320px" : "120px"); overflow-y: auto; min-height: 2.5rem;">
            @if (!Logs.Any())
            {
                <em class="text-secondary">No logs yet. Run analysis or zip upload to see output.</em>
            }
            else
            {
                <ul class="mb-0 ps-3" style="list-style:none;">
                    @foreach (var line in Logs)
                    {
                        <li class="py-0" style="white-space:pre-wrap; word-break:break-word;">@line</li>
                    }
                </ul>
            }
        </div>
    </div>

    <!-- Definitions -->
    <div class="mt-5">
        <h5>Definitions</h5>

        @if (IsRunning)
        {
            <div class="d-flex justify-content-center align-items-center" style="height:150px;">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Analyzing...</span>
                </div>
                <span class="ms-3 text-muted">Analyzing definitions...</span>
            </div>
        }
        else if (Results == null)
        {
            <p class="text-muted">No analysis run yet.</p>
        }
        else
        {
            <!-- Filter input -->
            <div class="mb-3">
                <input
                    value="@FilterText"
                    @oninput="@(e => OnFieldChanged("FilterText", e.Value?.ToString()))"
                    class="form-control"
                    placeholder="Filter definitions (FullName contains...)"
                    disabled="@IsRunning" />
            </div>

            @if (!DisplayDefs.Any())
            {
                <p class="text-danger">No definitions match "@FilterText".</p>
            }
            else
            {
                <DefinitionList @key="FilterText" Definitions="DisplayDefs" />
            }
        }
    </div>
</div>

@code {
    // --- persisted inputs ---
    private string? FilePath { get; set; }
    private int Depth { get; set; } = 1;
    private string FilterText { get; set; } = string.Empty;

    // --- UI state ---
    private bool IsRunning { get; set; }
    private List<string> Logs { get; } = new();
    private bool LogsExpanded { get; set; }
    private IEnumerable<DefinitionResult>? Results;

    // --- folder upload ---
    private bool UseZipMode { get; set; }
    private List<string> FolderCsPaths { get; } = new();
    private List<string> FolderSlnPaths { get; } = new();
    private string UploadTargetFile { get; set; } = "";
    private string UploadSolutionFile { get; set; } = "";
    private int UploadDepth { get; set; } = 1;
    private IDisposable? _dotNetRef;

    private void SetMode(bool zipMode)
    {
        UseZipMode = zipMode;
        StateHasChanged();
    }

    // guard so we only load cookies once
    private bool _cookiesLoaded;

    private IEnumerable<DefinitionDisplayModel> DisplayDefs =>
        Results?
            .SelectMany(r => r.Definitions.Values, (r, d) => new { r.File, Definition = d })
            .Select(x => new DefinitionDisplayModel
                {
                    Symbol = x.Definition.Symbol,
                    Namespace = x.Definition.Namespace,
                    FullName = x.Definition.FullName,
                    Code = x.Definition.Code,
                    SourceFile = x.File
                })
            .Where(d =>
                string.IsNullOrWhiteSpace(FilterText) ||
                d.FullName.Contains(FilterText, StringComparison.OrdinalIgnoreCase)
            )
        ?? Enumerable.Empty<DefinitionDisplayModel>();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_cookiesLoaded)
        {
            // read persisted inputs
            FilePath   = await JS.InvokeAsync<string>("getCookieByName", "FilePath")   ?? FilePath;
            var dc     = await JS.InvokeAsync<string>("getCookieByName", "Depth");
            if (int.TryParse(dc, out var dv)) Depth = dv;
            FilterText = await JS.InvokeAsync<string>("getCookieByName", "FilterText") ?? FilterText;

            _cookiesLoaded = true;
            StateHasChanged();
        }
    }

    // called on every text‐input for FilePath and FilterText
    private async Task OnFieldChanged(string fieldName, string? newValue)
    {
        switch (fieldName)
        {
            case "FilePath":   FilePath   = newValue; break;
            case "FilterText": FilterText = newValue ?? string.Empty; break;
        }

        await JS.InvokeVoidAsync("setCookie", fieldName, newValue ?? string.Empty);
    }

    // special handler for the numeric Depth field
    private async Task OnDepthChanged(ChangeEventArgs e)
    {
        var txt = e.Value?.ToString();
        if (int.TryParse(txt, out var v))
            Depth = v;
        else
            Depth = 0;

        await JS.InvokeVoidAsync("setCookie", "Depth", Depth.ToString());
    }

    void ToggleLogs() => LogsExpanded = !LogsExpanded;

    private async Task OnFolderSelected(ChangeEventArgs _)
    {
        var paths = await JS.InvokeAsync<string[]>("analyzerGetFolderCsPaths", "folderInput");
        var slnPaths = await JS.InvokeAsync<string[]>("analyzerGetFolderSlnPaths", "folderInput");
        FolderCsPaths.Clear();
        FolderSlnPaths.Clear();
        FolderCsPaths.AddRange(paths ?? Array.Empty<string>());
        FolderSlnPaths.AddRange(slnPaths ?? Array.Empty<string>());
        UploadTargetFile = FolderCsPaths.FirstOrDefault() ?? "";
        UploadSolutionFile = FolderSlnPaths.FirstOrDefault() ?? "";
        StateHasChanged();
    }

    private async Task RunUploadAnalysis()
    {
        if (string.IsNullOrEmpty(UploadTargetFile)) return;
        if (string.IsNullOrEmpty(UploadSolutionFile))
        {
            await AddLog("Select a .sln file from the folder. The folder must contain a solution file.");
            return;
        }
        IsRunning = true;
        Logs.Clear();
        Results = null;
        LogsExpanded = true;
        await AddLog("📁 Zipping folder and uploading…");
        StateHasChanged();
        try
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            var token = AuthService.Token ?? "";
            var baseUrl = Nav.BaseUri;
            await JS.InvokeVoidAsync("analyzerZipAndUpload", "folderInput", UploadTargetFile, UploadSolutionFile, UploadDepth, token, baseUrl, _dotNetRef);
        }
        catch (Exception ex)
        {
            await AddLog("❌ " + ex.Message);
        }
        finally
        {
            IsRunning = false;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task OnUploadComplete(string responseJson)
    {
        var logPrefix = "[Upload] ";
        try
        {
            await InvokeAsync(() => { Logs.Add(logPrefix + "Received payload length: " + (responseJson?.Length ?? 0)); });
            await InvokeAsync(StateHasChanged);

            var options = new System.Text.Json.JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true,
                PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase,
                ReadCommentHandling = System.Text.Json.JsonCommentHandling.Skip,
                AllowTrailingCommas = true
            };
            options.ReferenceHandler = System.Text.Json.Serialization.ReferenceHandler.IgnoreCycles;

            var response = System.Text.Json.JsonSerializer.Deserialize<UploadAnalyzerResponse>(responseJson, options);

            await InvokeAsync(() =>
            {
                Logs.Clear();
                Logs.Add(logPrefix + "Deserialized: Logs=" + (response?.Logs?.Count ?? -1) + ", Results=" + (response?.Results?.Count ?? -1));
                if (response?.Logs != null)
                    Logs.AddRange(response.Logs);
                if (response?.Results != null)
                {
                    Results = response.Results;
                    Logs.Add(logPrefix + "Results set: " + response.Results.Count + " file(s)");
                }
                else
                    Logs.Add(logPrefix + "WARNING: response.Results was null");
            });
        }
        catch (Exception ex)
        {
            await InvokeAsync(() =>
            {
                LogsExpanded = true;
                Logs.Add("❌ " + logPrefix + "Error: " + ex.Message);
                Logs.Add(logPrefix + "Type: " + ex.GetType().Name);
                Logs.Add(logPrefix + "Stack: " + (ex.StackTrace ?? "").Replace(Environment.NewLine, " | "));
                if (responseJson?.Length > 200)
                    Logs.Add(logPrefix + "Payload size " + responseJson.Length + " chars. If connection dropped, try a smaller solution.");
            });
        }
        finally
        {
            IsRunning = false;
        }
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();
        _dotNetRef = null;
    }

    async Task RunAnalysis()
    {
        IsRunning = true;
        Logs.Clear();
        Results     = null;
        FilterText  = string.Empty;
        LogsExpanded = false;

        await AddLog("🔍 Starting analysis…");
        StateHasChanged();

        var svc = new DefinitionFinderService(msg => InvokeAsync(() => AddLog(msg)));
        try
        {
            //Results = await svc.FindAllDefinitionsAsync(FilePath!, Depth);
            Results = await svc.FindMinimalDefinitionsAsync(FilePath!, Depth, explain: ExplainMode.ReasonForInclusion);
        }
        catch (Exception ex)
        {
            LogsExpanded = true;
            await AddLog("❌ " + ex.Message);
        }
        finally
        {
            IsRunning = false;
            StateHasChanged();
        }
    }

    private async Task AddLog(string log)
    {
        Logs.Add(log);
        StateHasChanged();
        try
        {
            await JS.InvokeVoidAsync("window.scrollToBottom", "logsContainer");
        }
        catch { /* ignore if prerendering or disconnected */ }
    }
}
